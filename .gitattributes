# Everything is text by default, unless we say otherwise.
# Also set everything to lf as line ending, because that's just way better.
* text     eol=lf

# Images are definitely not text.
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.tif      binary
*.tiff     binary
*.ico      binary

# More binary formats.
*.mp4      binary
*.pdf      binary
*.zip      binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.eot      binary

# SVGs should be handled as text, though.
*.svg      text

# Scripts
*.bash     text eol=lf
*.fish     text eol=lf
*.sh       text eol=lf
*.zsh      text eol=lf
# These are explicitly windows files and should use crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# Python
# Source files
*.pxd      text diff=python
*.py       text diff=python
*.py3      text diff=python
*.pyw      text diff=python
*.pyx      text diff=python
*.pyz      text diff=python
*.pyi      text diff=python

# Binary files
*.db       binary
*.p        binary
*.pkl      binary
*.pickle   binary
*.pyc      binary export-ignore
*.pyo      binary export-ignore
*.pyd      binary
# sphinx build artifact
*.doctree  binary

# Jupyter notebook
*.ipynb    text eol=lf

# Note: .db, .p, and .pkl files are associated
# with the python modules ``pickle``, ``dbm.*``,
# ``shelve``, ``marshal``, ``anydbm``, & ``bsddb``
# (among others).
